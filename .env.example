# Puerto en el que escuchará el servidor (por defecto 3001 en local)
PORT=3001

# Orígenes CORS permitidos para Socket.IO (por defecto * para admitir cualquier origen)
CORS_ORIGIN=*

# Activar (1) si el servidor corre detrás de un proxy inverso (Render, Railway, Fly.io, Nginx, Cloudflare)
# Esto asegura que el rate limiter identifique correctamente la IP real del cliente vía X-Forwarded-For
TRUST_PROXY=1

# Ruta personalizada a los archivos estáticos del cliente Vite (opcional, calculada automáticamente)
# CLIENT_DIST=../../client/dist
